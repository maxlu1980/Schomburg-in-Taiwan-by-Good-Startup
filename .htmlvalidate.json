{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off", "long-title": "off", "no-trailing-whitespace": "off", "attr-quotes": "off", "void-style": "off",
    "prefer-native-element": "off", "no-raw-characters": "off", "element-required-content": "off", "wcag/h32": "off",
    "no-dup-class": "off", "attribute-boolean-style": "off", "attribute-empty-style": "off", "doctype-style": "off",
    "no-implicit-button-type": "off", "valid-id": "off",
    "empty-heading": "off", "text-content": "off", "wcag/h30": "off", "unique-landmark": "off"
  }
}
